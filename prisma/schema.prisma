generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================================
// Identity & auth
// =========================================================================

enum Role {
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TwoFactorType {
  TOTP
  EMAIL_OTP
}

enum OtpPurpose {
  LOGIN_2FA
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id                 String     @id @default(cuid())
  // Primary login identifier. Encrypted at rest (AES-256-GCM, application layer);
  // cnicHash is a deterministic HMAC used for lookups/uniqueness since the
  // encrypted value itself cannot be queried directly.
  cnic               String
  cnicHash           String     @unique
  phone              String?
  phoneHash          String?    @unique
  // Optional — enables self-service password reset and email 2FA when present.
  email              String?    @unique
  name               String
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  twoFactorEnabled   Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  twoFactorMethods    TwoFactorMethod[]
  recoveryCodes       RecoveryCode[]
  otpCodes            OtpCode[]

  parentLinks ParentStudentLink[] @relation("ParentLinks")

  teacherAssignments  TeacherSubjectAssignment[]
  classesAsTeacher    Section[]                  @relation("SectionClassTeacher")
  timetableSlots      TimetableSlot[]
  markedAttendance    AttendanceRecord[]         @relation("AttendanceMarkedBy")
  assignmentsCreated  Assignment[]               @relation("AssignmentTeacher")
  submissionsGraded   Submission[]               @relation("SubmissionGradedBy")
  examsCreated        Exam[]                     @relation("ExamCreatedBy")
  datesheetsCreated   ExamDatesheet[]            @relation("DatesheetCreatedBy")
  examResultsEntered  ExamResult[]               @relation("ExamResultEnteredBy")
  invoicesIssued      FeeInvoice[]               @relation("InvoiceIssuedBy")
  paymentsReceived    FeePayment[]               @relation("PaymentReceivedBy")
  announcementsMade   Announcement[]             @relation("AnnouncementAuthor")
  notifications       Notification[]
  notificationSetting NotificationSetting?
  ticketsRaised       DeskTicket[]               @relation("TicketRaisedBy")
  ticketsAssigned     DeskTicket[]               @relation("TicketAssignedTo")
  ticketMessages      DeskTicketMessage[]
  auditLogEntries     AuditLog[]                 @relation("AuditActor")

  @@index([role])
  @@index([status])
  // The people directories order and search by name across every user.
  @@index([name])
}

// DB-backed refresh sessions — enables logout-everywhere and admin-forced logout.
enum DeviceClass {
  DESKTOP
  MOBILE
}

model Session {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String      @unique
  userAgent         String?
  ip                String?
  createdAt         DateTime    @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  /// What kind of device signed in. Desktop sessions are capped at 24
  /// hours; phones stay signed in until the person taps Log out.
  deviceClass       DeviceClass @default(DESKTOP)
  /// The hard deadline a desktop session can never be renewed past. Null
  /// on phones, which have no cap — that is the whole point of the phone
  /// policy, so it is represented as an absent deadline rather than a
  /// distant one that would quietly expire someone in a year's time.
  absoluteExpiresAt DateTime?
  /// Rolled forward on every token rotation, so the device list can show
  /// "last active" rather than only when the session began.
  lastSeenAt        DateTime    @default(now())
  /// Carried across rotations so the device list keeps one stable identity
  /// per browser, instead of appearing to be a new device every 15 minutes.
  chainId           String?

  @@index([userId])
  @@index([chainId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model TwoFactorMethod {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       TwoFactorType
  // TOTP secret, encrypted at rest. Null for EMAIL_OTP (uses User.email).
  secret     String?
  enabled    Boolean       @default(false)
  verifiedAt DateTime?
  createdAt  DateTime      @default(now())

  @@unique([userId, type])
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OtpPurpose
  createdAt  DateTime   @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([userId, purpose])
}

// =========================================================================
// People & relationships
// =========================================================================

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  TRANSFERRED
}

model StudentProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber      String?
  admissionNumber String        @unique
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  admissionDate   DateTime      @default(now())
  status          StudentStatus @default(ACTIVE)

  parentLinks ParentStudentLink[]
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  submissions Submission[]
  examResults ExamResult[]
  feeInvoices FeeInvoice[]

  @@index([status])
}

model TeacherProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String   @unique
  qualification String?
  joiningDate   DateTime @default(now())
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
}

model ParentStudentLink {
  id           String           @id @default(cuid())
  parentId     String
  parent       User             @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship RelationshipType
  isPrimary    Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

// =========================================================================
// Academic structure
// =========================================================================

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  terms          Term[]
  sections       Section[]
  enrollments    Enrollment[]
  assignments    TeacherSubjectAssignment[]
  feeStructures  FeeStructure[]
  examDatesheets ExamDatesheet[]
}

model Term {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "Mid Term", "Final Term"
  startDate      DateTime
  endDate        DateTime

  exams          Exam[]
  feeInvoices    FeeInvoice[]
  examDatesheets ExamDatesheet[]

  @@unique([academicYearId, name])
}

model Class {
  id        String @id @default(cuid())
  name      String @unique // stable grade label, e.g. "Grade 9"
  sortOrder Int    @default(0)

  sections Section[]
}

// The actual yearly instance students/teachers are assigned to.
model Section {
  id             String       @id @default(cuid())
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "A"
  classTeacherId String?
  classTeacher   User?        @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  capacity       Int?

  enrollments        Enrollment[]
  teacherAssignments TeacherSubjectAssignment[]
  timetableSlots     TimetableSlot[]
  attendanceRecords  AttendanceRecord[]
  assignments        Assignment[]
  exams              Exam[]
  feeStructures      FeeStructure[]
  examDatesheets     ExamDatesheet[]

  @@unique([classId, academicYearId, name])
  @@index([academicYearId])
  @@index([classTeacherId])
}

// Historical record — a student's section per academic year. Needed for
// accurate transcripts/report cards across years even after promotion.
model Enrollment {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  status         StudentStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())

  @@unique([studentId, academicYearId])
  @@index([sectionId])
  @@index([academicYearId])
  @@index([sectionId, academicYearId, status])
}

model Subject {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?

  teacherAssignments TeacherSubjectAssignment[]
  assignments        Assignment[]
  exams              Exam[]
  timetableSlots     TimetableSlot[]
  datesheetEntries   ExamDatesheetEntry[]
}

// Single source of truth for "what can this teacher touch" — used by
// row-level authorization checks throughout the app.
model TeacherSubjectAssignment {
  id             String       @id @default(cuid())
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, sectionId, academicYearId])
  @@index([teacherId])
  @@index([sectionId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model TimetableSlot {
  id        String    @id @default(cuid())
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User      @relation(fields: [teacherId], references: [id])
  dayOfWeek DayOfWeek
  startTime String // "08:00"
  endTime   String // "08:45"
  room      String?

  @@index([sectionId, dayOfWeek])
}

// =========================================================================
// Attendance / assignments / grading
// =========================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId  String
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  remarks    String?
  markedById String
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([studentId, date])
  @@index([sectionId, date])
  // Date-windowed analytics scan by date without a section filter.
  @@index([date])
}

model Assignment {
  id            String   @id @default(cuid())
  title         String
  description   String?
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       User     @relation("AssignmentTeacher", fields: [teacherId], references: [id])
  dueDate       DateTime
  attachmentUrl String?
  maxMarks      Float    @default(100)
  createdAt     DateTime @default(now())

  submissions Submission[]

  @@index([sectionId])
  @@index([teacherId])
  @@index([dueDate])
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  MISSING
}

model Submission {
  id            String           @id @default(cuid())
  assignmentId  String
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt   DateTime?
  fileUrl       String?
  status        SubmissionStatus @default(MISSING)
  marksObtained Float?
  feedback      String?
  gradedById    String?
  gradedBy      User?            @relation("SubmissionGradedBy", fields: [gradedById], references: [id])
  gradedAt      DateTime?

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId, status])
}

model Exam {
  id          String   @id @default(cuid())
  name        String // e.g. "Mid Term Exam"
  termId      String
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  totalMarks  Float    @default(100)
  examDate    DateTime
  createdById String
  createdBy   User     @relation("ExamCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  results ExamResult[]

  @@index([sectionId, termId])
}

model ExamResult {
  id            String         @id @default(cuid())
  examId        String
  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Float
  grade         String?
  remarks       String?
  enteredById   String
  enteredBy     User           @relation("ExamResultEnteredBy", fields: [enteredById], references: [id])
  enteredAt     DateTime       @default(now())

  @@unique([examId, studentId])
  @@index([studentId])
}

// =========================================================================
// Fees (manual/offline tracking; schema is gateway-ready but no gateway
// integration code is written in this phase)
// =========================================================================

// =========================================================================
// Uploaded files
// =========================================================================

/// An uploaded file held in the database.
///
/// Object storage is the textbook answer and it is the wrong default here.
/// This app is sold to schools that each choose their own server, so every
/// deployment that has not configured a bucket would otherwise fall back to
/// the local filesystem — which is read-only on a serverless host, so the
/// upload throws and the principal sees "something went wrong". That is
/// exactly what happened in production.
///
/// The volumes make it a comfortable trade: a logo is tens of kilobytes
/// after the browser downscales it, and a datesheet page is a few hundred.
/// Postgres handles that without noticing, the bytes are backed up and
/// restored with everything else rather than needing a second backup story,
/// and uploads work on any host with no configuration whatsoever. A bucket
/// is still used when one is configured.
model StoredFile {
  id          String   @id @default(cuid())
  /// Driver-independent key, e.g. "branding/k3x9.webp", so the same record
  /// can be located whichever driver is in use.
  key         String   @unique
  contentType String
  bytes       Bytes
  size        Int
  createdAt   DateTime @default(now())
}

// =========================================================================
// Examination datesheets
// =========================================================================

enum DatesheetStatus {
  DRAFT
  PUBLISHED
}

/// A published examination timetable.
///
/// Deliberately separate from `Exam`, which is one subject's paper for one
/// class and exists to carry marks. A datesheet is the notice a school pins
/// to the wall: it covers many classes and many papers at once, it is what
/// parents photograph and keep, and it has to stay readable exactly as it
/// was published even after the exams it describes are over.
model ExamDatesheet {
  id             String               @id @default(cuid())
  title          String
  academicYearId String
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?                @relation(fields: [termId], references: [id], onDelete: SetNull)
  /// Reuses the announcement vocabulary so "one class and its guardians"
  /// means the same thing here as it does for a notice.
  audience       AnnouncementAudience @default(ALL)
  sectionId      String?
  section        Section?             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// First day of the examinations, for sorting and for the "upcoming"
  /// badge. Derived from the entries when they exist, typed by hand when
  /// the datesheet is only a photograph.
  startsOn       DateTime?
  notes          String?
  status         DatesheetStatus      @default(DRAFT)
  publishedAt    DateTime?
  createdById    String
  createdBy      User                 @relation("DatesheetCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  pages   ExamDatesheetPage[]
  entries ExamDatesheetEntry[]

  @@index([status, publishedAt])
  @@index([academicYearId])
}

/// One photographed or scanned page of a datesheet.
///
/// Several, because a whole-school datesheet is rarely one sheet of paper —
/// and asking a principal to stitch four photographs into one image before
/// uploading is how a feature goes unused.
model ExamDatesheetPage {
  id          String        @id @default(cuid())
  datesheetId String
  datesheet   ExamDatesheet @relation(fields: [datesheetId], references: [id], onDelete: Cascade)
  /// What `storage.save` returned. Never handed to the browser directly —
  /// these are class-specific documents, so they are streamed through an
  /// authenticated route that re-checks who is asking.
  storageRef  String
  caption     String?
  sortOrder   Int           @default(0)

  @@index([datesheetId])
}

/// One paper, when the datesheet is built on the portal instead of photographed.
model ExamDatesheetEntry {
  id          String        @id @default(cuid())
  datesheetId String
  datesheet   ExamDatesheet @relation(fields: [datesheetId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// Stored as written, not looked up through the relation. A datesheet is
  /// a historical record — renaming a subject next year must not silently
  /// rewrite the notice parents were given last year.
  subjectName String
  examDate    DateTime
  /// "09:00" — a wall-clock time, not an instant, so it survives any
  /// timezone handling unchanged.
  startTime   String?
  endTime     String?
  room        String?
  sortOrder   Int           @default(0)

  @@index([datesheetId, examDate])
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

model FeeCategory {
  id   String @id @default(cuid())
  name String @unique // "Tuition", "Admission", "Transport", "Exam Fee"

  feeStructures FeeStructure[]
}

model FeeStructure {
  id             String       @id @default(cuid())
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeCategoryId  String
  feeCategory    FeeCategory  @relation(fields: [feeCategoryId], references: [id])
  amount         Float
  frequency      FeeFrequency
  dueDayOfMonth  Int?

  invoices FeeInvoice[]

  @@index([sectionId, academicYearId])
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model FeeInvoice {
  id               String         @id @default(cuid())
  invoiceNumber    String         @unique
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId   String?
  feeStructure     FeeStructure?  @relation(fields: [feeStructureId], references: [id])
  termId           String?
  term             Term?          @relation(fields: [termId], references: [id])
  amount           Float
  discount         Float          @default(0)
  lateFee          Float          @default(0)
  totalAmount      Float
  status           InvoiceStatus  @default(PENDING)
  dueDate          DateTime
  issuedAt         DateTime       @default(now())
  issuedById       String
  issuedBy         User           @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  // Reserved for a future online payment gateway integration — unused today.
  gatewayProvider  String?
  gatewayReference String?

  payments FeePayment[]

  @@index([studentId, status])
  @@index([status])
  @@index([dueDate])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  JAZZCASH
  EASYPAISA
  OTHER
}

model FeePayment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPaid    Float
  paymentMethod PaymentMethod
  paidAt        DateTime      @default(now())
  receivedById  String
  receivedBy    User          @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  receiptNumber String        @unique
  notes         String?

  @@index([invoiceId])
}

// =========================================================================
// Communication
// =========================================================================

enum AnnouncementAudience {
  ALL
  PRINCIPAL
  TEACHERS
  STUDENTS
  PARENTS
  /// One class's students.
  SECTION
  /// Everyone taught and teaching, but not guardians.
  STUDENTS_AND_TEACHERS
  /// One class's students together with their guardians — the right target
  /// for a datesheet or a holiday, which a parent needs as much as a child.
  SECTION_WITH_GUARDIANS
  /// The teachers who take one particular class.
  SECTION_TEACHERS
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  authorId    String
  author      User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  audience    AnnouncementAudience
  sectionId   String?
  publishedAt DateTime             @default(now())
  expiresAt   DateTime?

  @@index([audience, publishedAt])
}

enum NotificationType {
  ANNOUNCEMENT
  ATTENDANCE
  FEE
  GRADE
  ASSIGNMENT
  DESK_TICKET
  SYSTEM
}

/// Per-user control over what reaches them and whether it makes a sound.
/// A row is created on first use; absence means "every default is on".
model NotificationSetting {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Master switch for the in-app bell.
  enabled      Boolean @default(true)
  /// Plays a short chime when something new arrives while the app is open.
  soundEnabled Boolean @default(true)

  announcements Boolean @default(true)
  grades        Boolean @default(true)
  attendance    Boolean @default(true)
  fees          Boolean @default(true)
  assignments   Boolean @default(true)
  deskTickets   Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model DeskTicket {
  id           String         @id @default(cuid())
  raisedById   String
  raisedBy     User           @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  subject      String
  category     String?
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  messages DeskTicketMessage[]

  @@index([status])
}

model DeskTicketMessage {
  id            String     @id @default(cuid())
  ticketId      String
  ticket        DeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String
  author        User       @relation(fields: [authorId], references: [id])
  message       String
  attachmentUrl String?
  createdAt     DateTime   @default(now())

  @@index([ticketId])
}

// =========================================================================
// Platform
// =========================================================================

// Singleton row (application layer enforces a single row, id always "school").
model SchoolSettings {
  id               String   @id @default("school")
  schoolName       String   @default("My School")
  logoUrl          String?
  faviconUrl       String?
  /// Photograph of the school, used as the welcome screen's backdrop.
  buildingImageUrl String?
  /// One line shown under the school name on the welcome screen.
  tagline          String?
  primaryColor     String   @default("#0E6E68")
  address          String?
  phone            String?
  email            String?
  website          String?
  updatedById      String?
  updatedAt        DateTime @updatedAt
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  ROLE_CHANGED
  STUDENT_PII_VIEWED
  ATTENDANCE_MARKED
  GRADE_ENTERED
  GRADE_EDITED
  FEE_INVOICE_CREATED
  FEE_PAYMENT_RECORDED
  FEE_INVOICE_CANCELLED
  BRANDING_UPDATED
  ANNOUNCEMENT_PUBLISHED
}

// Written to explicitly at every sensitive mutation point — never relied on
// implicitly, so coverage is easy to verify in review.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id])
  action     AuditAction
  targetType String?
  targetId   String?
  // Redacted metadata only — never raw passwords/tokens/secrets.
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action, createdAt])
}
