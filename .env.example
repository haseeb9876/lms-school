# --- Database (PostgreSQL, e.g. Neon) ---
# Round trips dominate this app's page times: a query against a distant
# database costs far more than rendering the page that needs it. Deploy the
# app in the SAME REGION as the database — cross-region turns a 2ms query
# into a 200ms+ one, and a page making six of them into a page that feels
# broken.
#
# On a pooled provider (Neon's "-pooler" host, PgBouncer, Supabase's pooler)
# add pgbouncer=true so Prisma stops using prepared statements, which a
# transaction-mode pooler cannot keep across connections.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true&connection_limit=10"

# DIRECT_URL must be the UNPOOLED host — migrations need a real session and
# will fail or hang through a transaction pooler.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth / sessions ---
# Generate with: openssl rand -base64 48
JWT_SIGNING_SECRET="change-this-to-a-random-48-byte-secret"
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY="change-this-to-a-random-32-byte-hex-key"

# --- File storage (Vercel Blob) ---
# Create a Blob store in the Vercel dashboard and copy its token here.
BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting (Upstash Redis) ---
# Free tier at https://upstash.com — create a Redis database and copy these.
# If left empty, rate limiting falls back to an in-memory limiter (fine for local dev only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email (password reset, optional email 2FA) ---
# If left empty, outgoing emails are logged to the server console instead of sent.
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@example.com"
RESEND_API_KEY=""

# --- App ---
APP_URL="http://localhost:3000"
